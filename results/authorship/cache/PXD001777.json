{"accession": "PXD001777", "title": "Synaptosome Proteomics, Fraction 4", "additionalAttributes": [], "projectDescription": "Synaptosomes were isolated by Percoll gradient centrigation and iTRAQ based nanoLC-MS/MS proteomics. Three synapse fractions were studied from three kind of experimental rat groups namely, stressed with anhedonia, stress resilient and unstressed controls.", "sampleProcessingProtocol": "After gradient centrifugation fraction 3 was isolated and proteins were digested by trypsin, and the resulting peptides were iTRAQ labelled, fractionated by isoelectric focussing, purified and nano-LC-MS/MS analysed.", "dataProcessingProtocol": "Proteome Discoverer (Thermo Scientific) was applied for protein identifiation and quantification, using Mascot database search engine and Uniprot Rattus Norvegicus sequences (version 2012_3).", "projectTags": ["Biological", "Biomedical"], "keywords": ["Depression", "Brain", "Rat", "Anhedonic", "Stress", "Synapses"], "doi": "10.6019/PXD001777", "submissionType": "COMPLETE", "license": "EBI terms of use", "submissionDate": "2015-02-02", "publicationDate": "2016-04-26", "submitters": [{"title": "Professor", "firstName": "Johan ", "lastName": "Palmfeldt", "identifier": "17420111", "affiliation": "Aarhus University Hospital", "email": "johan.palmfeldt@clin.au.dk", "country": "Denmark", "orcid": "0000-0001-5585-639X", "name": "Johan  Palmfeldt", "id": "17420111"}], "labPIs": [{"title": "Dr", "firstName": "Johan", "lastName": "Palmfeldt", "identifier": "16750100", "affiliation": "Aarhus University Hospital, Denmark", "email": "johan.palmfeldt@clin.au.dk", "country": "", "orcid": "", "name": "Johan Palmfeldt", "id": "16750100"}], "instruments": [{"@type": "CvParam", "cvLabel": "MS", "accession": "MS:1000449", "name": "LTQ Orbitrap", "value": ""}], "softwares": [{"@type": "CvParam", "cvLabel": "MS", "accession": "MS:1001207", "name": "Mascot"}, {"@type": "CvParam", "cvLabel": "MS", "accession": "MS:1000650", "name": "Proteome Dis