{"accession": "PXD006582", "title": "Unrestricted analysis of modifications in proteins exposed to metal-catalyzed oxidation", "additionalAttributes": [], "projectDescription": "Bovine serum albumin and human serum proteins subjected to metal ion-catalyzed oxidation were analysed by LC-MS followed by unrestricted \"dependent peptide\" data analysis focused on oxidative modifications", "sampleProcessingProtocol": "Protein samples subjected to metal ion-catalyzed oxidation were digested with Glu-C and the resulting peptides were analysed on a Q-exactive Orbitrap (Thermo Fischer Scientific) coupled to an EASY-nLC 1000 liquid chromatograph (Thermo Fischer Scientific).", "dataProcessingProtocol": "Raw files were converted to .mgf files and database searches were performed with MaxQuant v 1.5.1 26 using the \u201cdependent peptide\u201d feature", "projectTags": ["Biological", "Technical"], "keywords": ["Lc-ms", "Mco", "Serum", "Oxidation", "Albumin"], "doi": "", "submissionType": "PARTIAL", "license": "EBI terms of use", "submissionDate": "2017-05-24", "publicationDate": "2017-09-21", "submitters": [{"title": "Dr", "firstName": "Per", "lastName": "H\u00e4gglund", "identifier": "74040101", "affiliation": "University of Copenhagen", "email": "hagglundperm@gmail.com", "country": "Denmark", "orcid": "0000-0002-6627-7518", "name": "Per H\u00e4gglund", "id": "74040101"}], "labPIs": [{"title": "Dr", "firstName": "Per", "lastName": "H\u00e4gglund", "identifier": "72150100", "affiliation": "Technical university of Denmark", "email": "hagglundperm@gmail.com", "country": "", "orcid": "", "name": "Per H\u00e4gglund", "id": "72150100"}], "instruments": [{"@type": "CvParam", "cvLabel": "MS", "accession": "MS:1001911", "name": "Q Exactive"}], "softwares": [{"@type": "CvParam", "cvLabel": "MS", "accession": "MS:1001583", "name": "MaxQuant"}], "experimentTypes": [{"@type": "CvParam", "cvLabel": "PRIDE", "accession": "PRIDE:0000429", "name": "Shotgun proteomics"}], "quantificationMethods":