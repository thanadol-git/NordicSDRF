{"accession": "PXD003007", "title": "Liraglutide effect on STZ Mouse Kidney with diabetic nephropathy", "additionalAttributes": [], "projectDescription": "The effect of liraglutide on the kidney proteome in the STZ mouse model compared to healthy and STZ diabetic control groups.", "sampleProcessingProtocol": "Tissue in soltion digestion with trypsin, oxidation, HZ capture, unbound fraction used and exposed to c18 cleanup, dried on speedvac and diluted for shotgun MS", "dataProcessingProtocol": "Raw data files were imported to Proteios. MGF files were searched in Mascot against the UniprotKB mouse w. rev seq database. Progenesis, SIMCA PCA and OPLS-DA, ANOVA w. Tukey multiple comparison was performed.", "projectTags": ["Biomedical"], "keywords": ["Liraglutide", "Kidney", "Proteome", "Stz", "Shotgun", "Diabetes nephropathy", "Label-free"], "doi": "10.6019/PXD003007", "submissionType": "COMPLETE", "license": "EBI terms of use", "submissionDate": "2015-12-08", "publicationDate": "2019-01-18", "submitters": [{"title": "Mrs", "firstName": "Leena", "lastName": "Liljedahl", "identifier": "29590124", "affiliation": "Department of Immunotechnology, Lund University, Sweden", "email": "leena.liljedahl@immun.lth.se", "country": "Sweden", "orcid": "", "name": "Leena Liljedahl", "id": "29590124"}], "labPIs": [{"title": "Dr", "firstName": "Peter", "lastName": "James", "identifier": "35660100", "affiliation": "Department of Immunotechnology, Lund University", "email": "peter.james@immun.lth.se", "country": "", "orcid": "", "name": "Peter James", "id": "35660100"}], "instruments": [{"@type": "CvParam", "cvLabel": "MS", "accession": "MS:1001910", "name": "LTQ Orbitrap Elite"}], "softwares": [{"@type": "CvParam", "cvLabel": "MS", "accession": "MS:1001207", "name": "Mascot"}], "experimentTypes": [{"@type": "CvParam", "cvLabel": "PRIDE", "accession": "PRIDE:0000429", "name": "Shotgun proteomics"}], "quantificationMethods": [], "countries": ["Sweden"], "sampleAttributes": [{"@type": "Tupl