{"accession": "PXD056050", "title": "Immune cells from human peripheral blood", "additionalAttributes": [], "projectDescription": "Different immune cells were isolated from PBMCs using flow cytometry", "sampleProcessingProtocol": "Isolated PBMCs were stained with viability staining and further stained with a panel of antibodies and sorted on BD FACSAria IIu. Approximately 100000 each of B-cells, na\u00efve B-cells, T-cells, cytotoxic T-cell, monocytes and activated NK-cells as well as a 50-50 mixture of CD8+ T cells and monocytes were collected in quadruplicates. Samples were loaded to S-traps and processed accordin to the manufacturer instructions with overnight LysC-trypsin (1:9) digestion. Peptide eluates were dried, resuspended and loaded on Evotips. A 58 minute whisper method was used for LC separation using a EvoSep one system with a 15 cm picofrit column with online data-independent acquisition with 12 m/z staggered windows on a QExactive HF-X mass spectrpmeter.", "dataProcessingProtocol": "The raw data files were converted to mzML using msconvert from Proteowizard with vendor peak picking and demultiplexing. The mzML files were searched using DIA-NN version 1.8.1 in library free mode using the UniProt human fasta database with contaminants added. Quantification was with the robust LC (high precision) setting.", "projectTags": [], "keywords": ["Immune cells", "Pbmc"], "doi": "", "submissionType": "PARTIAL", "license": "Creative Commons Public Domain (CC0)", "submissionDate": "2024-09-20", "publicationDate": "2025-07-14", "submitters": [{"title": "Dr", "firstName": "Fredrik", "lastName": "Levander", "identifier": "690182", "affiliation": "Lund University,\r\nDepartment of Immunotechnology", "email": "fredrik.levander@immun.lth.se", "country": "Sweden", "orcid": "0000-0002-0710-9792", "name": "Fredrik Levander", "id": "690182"}], "labPIs": [{"title": "Dr", "firstName": "Fredrik", "lastName": "Levander", "identifier": "3003149", "affiliation": "Department of Immunotechnology, Lund University", "email": "fredrik.levander@immun.lth.se", "country": "", "orcid": "", "name": "Fredrik Levander", "id": "3003149"}], "instruments": [{"@type": "CvParam", "cvLabel": "MS", "accession": "MS:1002877", "name": "Q Exactive HF-X"}], "softwares": [{"@type": "CvParam", "cvLabel": "MS", "accession": "MS:1003253", "name": "DIA-NN"}], "experimentTypes": [{"@type": "CvParam", "cvLabel": "PRIDE", "accession": "PRIDE:0000450", "name": "Data-independent acquisition"}, {"@type": "CvParam", "cvLabel": "PRIDE", "accession": "PRIDE:0000428", "name": "Bottom-up proteomics"}], "quantificationMethods": [{"@type": "CvParam", "cvLabel": "PRIDE", "accession": "PRIDE:0000323", "name": "TIC"}], "countries": ["Sweden"], "sampleAttributes": [{"@type": "Tuple", "key": {"cvLabel": "EFO", "accession": "EFO:0000635", "name": "organism part"}, "value": [{"cvLabel": "CL", "accession": "CL:0000081", "name": "blood cell"}, {"cvLabel": "BTO", "accession": "BTO:0000089", "name": "blood"}, {"cvLabel": "CL", "accession": "CL:0000084", "name": "T cell"}, {"cvLabel": "CL", "accession": "CL:0000623", "name": "natural killer cell"}, {"cvLabel": "CL", "accession": "CL:0000236", "name": "B cell"}, {"cvLabel": "CL", "accession": "CL:0000576", "name": "monocyte"}]}, {"@type": "Tuple", "key": {"cvLabel": "EFO", "accession": "OBI:0100026", "name": "organism"}, "value": [{"cvLabel": "NEWT", "accession": "NEWT:9606", "name": "Homo sapiens (Human)"}]}], "organisms": [{"@type": "CvParam", "cvLabel": "NEWT", "accession": "NEWT:9606", "name": "Homo sapiens (human)"}], "organismParts": [{"@type": "CvParam", "cvLabel": "BTO", "accession": "BTO:0000089", "name": "Blood"}, {"@type": "CvParam", "cvLabel": "CL", "accession": "CL:0000084", "name": "T cell"}, {"@type": "CvParam", "cvLabel": "CL", "accession": "CL:0000236", "name": "B cell"}, {"@type": "CvParam", "cvLabel": "CL", "accession": "CL:0000576", "name": "Monocyte"}, {"@type": "CvParam", "cvLabel": "CL", "accession": "CL:0000081", "name":